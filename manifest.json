{
  "manifestVersion": 5,
  "id": "template.engine",
  "name": "Template Engine",
  "version": "1.0.0",
  "main": "index.html",

  "host": [
    {
      "app": "PS",
      "minVersion": "22.0.0"
    }
  ],

  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/TE.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ],

  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",

      "label": {
        "default": "Template Engine"
      },

      "icons": [
        {
          "width": 48,
          "height": 48,
          "path": "icons/TE.png",
          "scale": [1, 2],
          "theme": ["all"],
          "species": ["generic"]
        }
      ]
    }
  ]
}
